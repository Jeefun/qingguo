export class QgThemeOption {
  id: string;
  title: string;
  subtitle: string;
  tag: string;

  constructor(id: string, title: string, subtitle: string, tag: string) {
    this.id = id;
    this.title = title;
    this.subtitle = subtitle;
    this.tag = tag;
  }
}

const THEME_OPTIONS: QgThemeOption[] = [
  new QgThemeOption("white", "纯白", "黑白灰单色，极简纯粹", "新作"),
  new QgThemeOption("lime", "青柠", "月白与青柠，清爽鲜明", "经典"),
  new QgThemeOption("sea", "海盐蓝", "雾蓝画布，静谧深海", "原有"),
  new QgThemeOption("apricot", "暖杏", "奶油暖杏，温柔松弛", "原有"),
  new QgThemeOption("iris", "雾紫", "轻雾淡紫，静谧梦境", "新作"),
  new QgThemeOption("rose", "蔷薇", "柔粉与莓色，浪漫克制", "新作"),
  new QgThemeOption("jade", "松玉", "清润玉绿，深林夜色", "新作"),
  new QgThemeOption("gold", "曜金", "香槟浅金，沉稳墨色", "新作")
];

export class QgTheme {
  static options(): QgThemeOption[] {
    return THEME_OPTIONS.slice();
  }

  static normalize(value: string): string {
    return THEME_OPTIONS.some((option: QgThemeOption): boolean => option.id === value) ? value : 'lime';
  }

  static color(name: string, theme: string, dark: boolean): string {
    const palette: Record<string, string> = theme === 'sea' ? (dark ? SEA_DARK : SEA_LIGHT) :
      theme === 'apricot' ? (dark ? APRICOT_DARK : APRICOT_LIGHT) :
      theme === 'iris' ? (dark ? IRIS_DARK : IRIS_LIGHT) :
      theme === 'rose' ? (dark ? ROSE_DARK : ROSE_LIGHT) :
      theme === 'jade' ? (dark ? JADE_DARK : JADE_LIGHT) :
      theme === 'gold' ? (dark ? GOLD_DARK : GOLD_LIGHT) :
      theme === 'white' ? (dark ? WHITE_DARK : WHITE_LIGHT) : (dark ? LIME_DARK : LIME_LIGHT);
    return palette[name] !== undefined ? palette[name] : palette['text'];
  }

  static veil(alpha: string, theme: string, dark: boolean): string {
    return '#' + alpha + QgTheme.color('bg', theme, dark).substring(1);
  }
}
